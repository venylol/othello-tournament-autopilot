{
  "manifest_version": 3,
  "name": "本轮自律 · FTD 本地桥",
  "version": "0.2.0",
  "description": "仅连接 Flip the Disc 与 127.0.0.1 本地比赛协调器。",
  "key": "",
  "permissions": ["downloads"],
  "host_permissions": [
    "https://flipthedisc.com/*",
    "https://www.flipthedisc.com/*",
    "http://127.0.0.1:4174/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "本轮自律 · FTD 本地桥",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://flipthedisc.com/*", "https://www.flipthedisc.com/*"],
      "js": ["vendor/socket.io.min.js", "page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://flipthedisc.com/*", "https://www.flipthedisc.com/*"],
      "js": ["content-relay.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
